# Optional settings. The app runs without any of them.
# To use one locally, copy this file to server/.env and uncomment the line.
# On Railway, add it under the service's Variables tab instead.

# Port for `npm start`. Railway sets this for you. (`npm run dev` always uses 4000,
# because that is where the Vite dev server proxies /api requests.)
# PORT=4000

# Folder that holds the SQLite database file, space.db. Use an absolute path.
# Default: server/data locally, or the attached volume when running on Railway.
# DATA_DIR=/data

# How many reverse proxies sit in front of the server, so it can see real visitor IPs
# and tell HTTPS from HTTP. Default: 1 in production (correct for Railway), off otherwise.
# TRUST_PROXY=1
