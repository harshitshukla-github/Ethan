# Copy this file to .env and fill in your values. .env is git-ignored; never commit it.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zero_waste_matchmaker
DB_CONNECTION_LIMIT=10

# --- Google Maps JavaScript API ---
# Browser key: restrict it in Google Cloud Console to HTTP referrers (e.g. http://localhost:3000/*)
# and to the "Maps JavaScript API" only.
GOOGLE_MAPS_API_KEY=
# Advanced Markers need a Map ID. DEMO_MAP_ID works for local development.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
