{
  "name": "zero-waste-matchmaker",
  "version": "1.0.0",
  "private": true,
  "description": "Find compost drop-offs, e-waste recycling, bulk refill stores and recycling centers on a map, and suggest new ones.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:seed": "node scripts/setup-db.js --seed",
    "db:reset": "node scripts/setup-db.js --reset --seed",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6"
  }
}
