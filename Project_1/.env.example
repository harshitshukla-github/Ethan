# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=paste_your_client_id_here
SPOTIFY_CLIENT_SECRET=paste_your_client_secret_here

# Register this EXACT address in the Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
PORT=3000

# Generate a random value with the command in README.md.
SESSION_SECRET=replace_with_a_random_secret
